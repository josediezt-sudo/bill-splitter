# Anthropic API (requerido: OCR de recibos y lectura de emails bancarios)
ANTHROPIC_API_KEY=sk-ant-...

# MongoDB Atlas (requerido en producción para persistencia real de datos)
# Sin esta variable, la app guarda todo en archivos locales (se pierden si el hosting reinicia el servicio)
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Google OAuth (requerido para sincronizar Gmail)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# En producción (Render), usar:
# GOOGLE_REDIRECT_URI=https://tu-app.onrender.com/api/gmail/callback
